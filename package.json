{
  "name": "katakecil-personal-library",
  "private": true,
  "version": "8.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:content-edge && node scripts/verify-public-build.mjs && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "import:episodes": "node scripts/import-episodes.mjs",
    "test:v3": "node scripts/test-v3-planning.mjs",
    "test:v42": "node scripts/test-v42-security.mjs",
    "test:v421": "node scripts/test-v421-reader.mjs",
    "test:v45": "node scripts/test-v45.mjs",
    "test:current": "node scripts/test-current.mjs",
    "check:structure": "node scripts/quality/check-structure.mjs",
    "test:v6121": "node scripts/test-v6121.mjs",
    "audit:v7-theme": "node scripts/audit-v7-theme.mjs",
    "audit:v7beta": "node scripts/audit-v7beta.mjs",
    "test:v72": "node scripts/test-v72-import.mjs && node scripts/test-v72-database.mjs && node scripts/test-v72-reader-pwa.mjs",
    "test:browser": "node scripts/test-studio-workspace-browser.mjs",
    "check": "npm run lint && npm run check:structure && npm run test:current",
    "clean:obsolete": "node scripts/clean-obsolete.mjs",
    "test:v74": "node scripts/test-v74-revisions.mjs",
    "test:v73": "node scripts/test-v73-covers.mjs",
    "test:edge": "node scripts/test-v73-edge.mjs",
    "test:v75": "node scripts/test-v75.mjs",
    "test:v75:browser": "node scripts/test-v75-browser.mjs",
    "cleanup:deleted-covers": "node scripts/deleted-cover-cleanup.mjs",
    "build:android": "node scripts/verify-android-env.mjs && npm run build -- --mode android && node scripts/verify-android-assets.mjs && cap sync android",
    "android:debug": "npm run build:android && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "test:android": "node scripts/test-android-integration.mjs",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleRelease",
    "test:crystal": "node scripts/test-crystal-browser.mjs",
    "release:web": "node scripts/prepare-web-release.mjs && npm run build",
    "test:push": "node scripts/test-web-push.mjs && node scripts/test-web-push-worker.mjs && node scripts/test-web-push-cron.mjs && deno check --node-modules-dir=manual --frozen --config supabase/functions/web-push-dispatch/deno.json supabase/functions/web-push-subscribe/index.ts supabase/functions/web-push-unsubscribe/index.ts supabase/functions/web-push-dispatch/index.ts && deno test --node-modules-dir=manual --frozen --config supabase/functions/web-push-dispatch/deno.json supabase/functions/_shared/web-push/runtime_test.ts",
    "test:epub": "node scripts/test-epub.mjs && node scripts/test-studio-workspace-browser.mjs",
    "test:shelf": "node scripts/test-crystal-browser.mjs",
    "verify:apk": "node scripts/verify-android-apk.mjs",
    "test:studio": "node scripts/test-studio-workspace.mjs",
    "test:studio:browser": "node scripts/test-studio-workspace-browser.mjs",
    "build:content-edge": "node scripts/build-content-edge.mjs",
    "test:studio:edge": "npm run build:content-edge && deno check --node-modules-dir=manual --frozen --config supabase/functions/book-content/deno.json supabase/functions/book-content/index.ts && node scripts/test-studio-edge.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@supabase/supabase-js": "2.117.3",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@xmldom/xmldom": "0.9.12",
    "dompurify": "3.4.17",
    "jszip": "3.10.1",
    "marked": "17.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "0.5.9",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.1.2",
    "deno": "2.9.6",
    "fake-indexeddb": "6.2.4",
    "playwright": "1.56.1",
    "rolldown": "1.2.13",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wasm-feature-detect": "1.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
