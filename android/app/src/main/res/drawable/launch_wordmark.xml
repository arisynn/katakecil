<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep the complete wide About wordmark inside Android's circular icon mask. -->
    <item android:width="288dp" android:height="288dp">
        <shape><solid android:color="@android:color/transparent" /></shape>
    </item>
    <item android:width="168dp" android:height="56dp" android:gravity="center">
        <bitmap android:src="@drawable/katakecil_wordmark" android:gravity="fill"
            android:tint="@color/splash_wordmark_ink" />
    </item>
</layer-list>
